# =============================================================================
# ERP.js - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Duplicate this file to .env and fill in your actual credentials.
# Keep your real .env file secure and never commit it to version control.
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
OPENSSL_CONF='/dev/null'

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Primary MongoDB connection string (local instance or MongoDB Atlas)
DATABASE="mongodb://localhost:27017/erpjs"

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# JWT Secret for token signing and verification
# Generate a secure 64+ char random string (e.g., openssl rand -hex 32)
JWT_SECRET="your_jwt_secret_key_change_me_in_production"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Public server file URL for file access and uploads
PUBLIC_SERVER_FILE="http://localhost:8888/"

# =============================================================================
# EMAIL SERVICE CONFIGURATION (SMTP)
# =============================================================================
# SMTP settings for sending system emails, invoice notifications, and invites
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# =============================================================================
# AI SERVICE API KEYS (Optional)
# =============================================================================
# OpenAI API for AI-powered features, smart CRM summaries, and follow-ups
OPENAI_API_KEY=your_openai_api_key_here

# Claude AI API for additional AI intelligence models
CLAUDE_API_KEY=your_claude_api_key_here

# Additional email/AI services
# RESEND_API=your_resend_api_key_here

# =============================================================================
# SOCIAL MEDIA INTEGRATION - FACEBOOK (Optional)
# =============================================================================
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

# =============================================================================
# SOCIAL MEDIA INTEGRATION - INSTAGRAM (Optional)
# =============================================================================
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# =============================================================================
# SOCIAL MEDIA INTEGRATION - TWITTER/X (Optional)
# =============================================================================
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_KEY_SECRET=your_twitter_api_key_secret_here

# =============================================================================
# URL SHORTENING & TRACKING SERVICES (Optional)
# =============================================================================
BITLY_ACCESS_TOKEN=your_bitly_access_token_here

# =============================================================================
# SMS SERVICE CONFIGURATION - TWILIO (Optional)
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15555555555
SMS_ENABLED=false

# Alternative SMS provider: SendGrid (for email-to-SMS gateway)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
