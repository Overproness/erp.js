{
  "name": "erp-crm",
  "version": "4.1.0",
  "engines": {
    "npm": "10.2.4",
    "node": "20.9.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:ts": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "production": "NODE_ENV=production",
    "setup": "ts-node -r tsconfig-paths/register src/setup/setup.ts",
    "urlsetup": "ts-node -r tsconfig-paths/register src/setup/urlSetup.ts",
    "reset": "ts-node -r tsconfig-paths/register src/setup/reset.ts",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "check:model-esm": "node scripts/check-model-esm.cjs",
    "smoke:models": "tsx scripts/model-loading-smoke.ts",
    "smoke:app": "tsx scripts/app-startup-smoke.ts",
    "test:smoke": "npm run check:model-esm && npm run smoke:models && npm run smoke:app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@apollo/server": "^4.13.0",
