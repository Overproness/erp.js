    "crypto": "^1.0.1",
    "csv-parser": "^3.2.0",
    "currency.js": "2.0.4",
    "dotenv": "16.3.1",
    "ejs": "^3.1.9",
    "expr-eval": "^2.0.2",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.4.0",
    "geoip-lite": "^1.4.10",
    "glob": "10.3.10",
    "graphql": "^16.13.1",
    "graphql-tag": "^2.12.6",
    "html-pdf": "^3.0.1",
    "html-to-text": "^9.0.5",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^17.13.3",
