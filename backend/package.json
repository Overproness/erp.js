{
  "name": "erp-crm",
  "version": "4.1.0",
  "engines": {
    "npm": "10.2.4",
    "node": "20.9.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js --ignore public/ --ignore tests/",
    "production": "NODE_ENV=production",
    "setup": "node src/setup/setup.js",
    "urlsetup": "node src/setup/urlSetup.js",
    "upgrade": "node src/setup/upgrade.js",
    "reset": "node src/setup/reset.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=unit",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=integration",
    "test:tier1": "cross-env NODE_ENV=test jest --testPathPattern=tier1",
    "test:tier2": "cross-env NODE_ENV=test jest --testPathPattern=tier2",
    "test:tier3": "cross-env NODE_ENV=test jest --testPathPattern=tier3",
    "test:tier4": "cross-env NODE_ENV=test jest --testPathPattern=tier4",
    "test:security": "cross-env NODE_ENV=test jest tests/security/ --testPathIgnorePatterns=[]",
    "test:performance": "cross-env NODE_ENV=test jest tests/performance/ --testPathIgnorePatterns=[]",
    "test:performance:artillery": "artillery run tests/performance/load-test.yml",
    "test:all": "node tests/run-all-tests.js",
    "test:comprehensive:unit": "node tests/run-all-tests.js --unit-only",
    "test:comprehensive:integration": "node tests/run-all-tests.js --integration-only",
    "test:comprehensive:coverage": "node tests/run-all-tests.js --coverage-only",
    "test:comprehensive:quick": "node tests/run-all-tests.js --quick",
    "test:fast": "cross-env NODE_ENV=test jest --testPathPattern=\"tier1|tier2|unit\"",
    "test:e2e": "cross-env NODE_ENV=test jest --testPathPattern=e2e",
    "lint": "eslint src/ --ext .js",
    "lint:security": "eslint src/ --ext .js --config .eslintrc.security.js",
    "check": "python src/setup/check.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.509.0",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "currency.js": "2.0.4",
    "dotenv": "16.3.1",
    "ejs": "^3.1.9",
    "expr-eval": "^2.0.2",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.4.0",
    "geoip-lite": "^1.4.10",
    "glob": "10.3.10",
    "html-pdf": "^3.0.1",
    "html-to-text": "^9.0.5",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mammoth": "^1.9.1",
    "mime-types": "^2.1.35",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "mongoose": "^8.1.1",
    "mongoose-autopopulate": "^1.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.4",
    "nanoid": "^3.3.11",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.3",
    "openai": "^5.8.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf.js-extract": "^0.2.1",
    "pdfkit": "^0.17.1",
    "phantomjs-prebuilt": "^2.1.16",
    "pug": "^3.0.2",
    "qrcode": "^1.5.4",
    "rate-limit-mongo": "^2.3.2",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.7.0",
    "request-ip": "^3.3.0",
    "resend": "^2.0.0",
    "shortid": "^2.2.16",
    "transliteration": "^2.3.5",
    "ua-parser-js": "^2.0.4",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "vm2": "^3.9.19",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/jest": "^29.5.12",
    "artillery": "^2.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^2.1.0",
    "faker": "^6.6.6",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "mongodb-memory-server": "^9.1.5",
    "nodemon": "3.0.1",
    "supertest": "^6.3.4"
  },
  "_moduleAliases": {
    "@": "src"
  },
  "main": "server.js",
  "author": "Muntazar&Wasif",
  "email": "mwasifshkeel@gmail.com",
  "license": "Fair-code License"
}
