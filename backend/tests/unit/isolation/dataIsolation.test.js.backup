const mongoose = require('mongoose');
const TestDataFactory = require('../../utils/testDataFactory');
const { faker } = require('@faker-js/faker');

describe('Data Isolation Unit Tests', () => {
  let Client, Invoice, Payment;

  beforeAll(() => {
    Client = mongoose.model('Client');
    Invoice = mongoose.model('Invoice');
    Payment = mongoose.model('Payment');
  });

  // Helper function to create client without auto-populate issues
  const createTestClient = async (owner, overrides = {}) => {
    const clientData = {
      name: faker.person.fullName(),
      email: `test-client-${Date.now()}-${Math.random().toString(36).substr(2, 5)}@example.com`,
      phone: faker.phone.number(),
      country: faker.location.country(),
      address: faker.location.streetAddress(),
      owner: owner._id,
      // Don't set createdBy, updatedBy, removedBy to avoid auto-populate hanging issues
      enabled: true,
      removed: false,
      customerType: faker.helpers.arrayElement(['individual', 'company']),
      demographics: {
        age: faker.number.int({ min: 18, max: 80 }),
        gender: faker.helpers.arrayElement(['male', 'female', 'other']),
        location: faker.location.city(),
      },
      behavior: {
        lastPurchaseDate: faker.date.recent(),
        purchaseFrequency: faker.helpers.arrayElement(['low', 'medium', 'high']),
      },
      customerValue: {
        lifetimeValue: faker.number.float({ min: 1000, max: 50000 }),
        segment: 'bronze',
      },
      ...overrides,
    };

    return await new Client(clientData).save();
  };

  describe('Owner Field Validation', () => {
    test('should require owner field in models', async () => {
      // Test Client model
      const clientData = {
        name: 'Test Client',
        email: 'test@example.com',
        phone: '123-456-7890',
        // Missing owner field
      };

      await expect(new Client(clientData).save()).rejects.toThrow();
    }, 15000);

    test('should save with valid owner field', async () => {
      const owner = await TestDataFactory.createCompanyOwner();

      const clientData = {
        name: 'Test Client',
        email: 'test@example.com',
        phone: '123-456-7890',
        owner: owner._id,
        // Don't set createdBy to avoid auto-populate
        enabled: true,
        removed: false,
      };

      const client = await new Client(clientData).save();
      // Handle autopopulated owner field
      const ownerId = client.owner._id || client.owner;
      expect(ownerId.toString()).toBe(owner._id.toString());
    }, 30000);

    test('should validate owner field is ObjectId', async () => {
      const clientData = {
        name: 'Test Client',
        email: 'test@example.com',
        phone: '123-456-7890',
        owner: 'invalid-owner-id', // Invalid ObjectId
        enabled: true,
        removed: false,
      };

      await expect(new Client(clientData).save()).rejects.toThrow();
    }, 15000);

    test('should validate owner exists', async () => {
      const nonExistentOwnerId = new mongoose.Types.ObjectId();

      const clientData = {
        name: 'Test Client',
        email: 'test@example.com',
        phone: '123-456-7890',
        owner: nonExistentOwnerId,
        // Don't set createdBy to avoid auto-populate
        enabled: true,
        removed: false,
      };

      // This should work at the model level but fail at business logic level
      const client = await new Client(clientData).save();
      // Check without populate and without autopopulate to get the raw ObjectId
      const rawClient = await Client.findById(client._id).lean();
      expect(rawClient.owner.toString()).toBe(nonExistentOwnerId.toString());
    }, 15000);
  });

  describe('Query Filtering by Owner', () => {
    test('should filter queries by owner', async () => {
      const owner1 = await TestDataFactory.createCompanyOwner();
      const owner2 = await TestDataFactory.createCompanyOwner();

      // Create clients for different owners using safe method
      const client1 = await createTestClient(owner1);
      const client2 = await createTestClient(owner2);

      // Query by owner1 using lean() to avoid auto-populate
      const owner1Clients = await Client.find({ owner: owner1._id, removed: false }).lean();
      expect(owner1Clients).toHaveLength(1);
      expect(owner1Clients[0]._id.toString()).toBe(client1._id.toString());

      // Query by owner2 using lean() to avoid auto-populate
      const owner2Clients = await Client.find({ owner: owner2._id, removed: false }).lean();
      expect(owner2Clients).toHaveLength(1);
      expect(owner2Clients[0]._id.toString()).toBe(client2._id.toString());
    }, 45000);

    test('should return empty results for non-owner queries', async () => {
      const owner1 = await TestDataFactory.createCompanyOwner();
      const owner2 = await TestDataFactory.createCompanyOwner();

      await createTestClient(owner1);

      // Query by owner2 should return empty using lean()
      const owner2Clients = await Client.find({ owner: owner2._id, removed: false }).lean();
      expect(owner2Clients).toHaveLength(0);
    }, 30000);

    test('should handle complex queries with owner filter', async () => {
      const owner = await TestDataFactory.createCompanyOwner();

      await createTestClient(owner, { name: 'Client A', customerType: 'company' });
      await createTestClient(owner, { name: 'Client B', customerType: 'individual' });
      await createTestClient(owner, { name: 'Client C', customerType: 'company' });

      const companyClients = await Client.find({
        owner: owner._id,
        removed: false,
        customerType: 'company',
      }).lean();

      expect(companyClients).toHaveLength(2);
    }, 45000);

    test('should apply owner filter to aggregation queries', async () => {
      const owner1 = await TestDataFactory.createCompanyOwner();
      const owner2 = await TestDataFactory.createCompanyOwner();

      await createTestClient(owner1);
      await createTestClient(owner1);
      await createTestClient(owner2);

      const aggregationResult = await Client.aggregate([
        { $match: { owner: owner1._id, removed: false } },
        { $group: { _id: null, count: { $sum: 1 } } },
      ]);

      expect(aggregationResult[0].count).toBe(2);
    }, 30000);
  });

  describe('Data Access Permissions', () => {
    test('should validate user permissions for data access', () => {
      const checkPermission = (user, action, resource) => {
        if (user.role === 'owner') return true;

        const permissionMap = {
          read: {
            client: 'canViewClients',
            invoice: 'canViewInvoices',
            payment: 'canViewPayments',
            task: 'canViewTasks',
            document: 'canViewDocuments',
            report: 'canViewReports',
            analytics: 'canViewAnalytics',
            settings: 'canViewSettings',
            notification: 'canViewNotifications',
          },
          write: {
            client: 'canEditClients',
            invoice: 'canEditInvoices',
            payment: 'canEditPayments',
            task: 'canUpdateTasks',
            document: 'canUpdateDocuments',
            report: 'canUpdateReports',
            analytics: null, // usually read-only
            settings: 'canUpdateSettings',
            notification: 'canUpdateNotifications',
          },
        };

        const permissionKey = permissionMap[action]?.[resource];
        return permissionKey ? user.permissions?.[permissionKey] || false : false;
      };

      const owner = { role: 'owner', permissions: {} };
      const user = {
        role: 'member',
        permissions: {
          canViewClients: true,
          canViewInvoices: false,
          canEditClients: false,
          canViewTasks: true,
          canUpdateTasks: false,
          canViewDocuments: true,
          canUpdateDocuments: false,
          canViewReports: true,
          canUpdateReports: false,
          canViewAnalytics: true,
          canViewSettings: true,
          canUpdateSettings: false,
          canViewNotifications: true,
          canUpdateNotifications: false,
        },
      };

      expect(checkPermission(owner, 'read', 'client')).toBe(true);
      expect(checkPermission(owner, 'write', 'invoice')).toBe(true);

      expect(checkPermission(user, 'read', 'client')).toBe(true);
      expect(checkPermission(user, 'read', 'invoice')).toBe(false);
      expect(checkPermission(user, 'write', 'client')).toBe(false);

      // New permission checks
      expect(checkPermission(user, 'read', 'task')).toBe(true);
      expect(checkPermission(user, 'write', 'task')).toBe(false);
      expect(checkPermission(user, 'read', 'document')).toBe(true);
      expect(checkPermission(user, 'write', 'document')).toBe(false);
      expect(checkPermission(user, 'read', 'report')).toBe(true);
      expect(checkPermission(user, 'write', 'report')).toBe(false);
      expect(checkPermission(user, 'read', 'analytics')).toBe(true);
      expect(checkPermission(user, 'write', 'analytics')).toBe(false);
      expect(checkPermission(user, 'read', 'settings')).toBe(true);
      expect(checkPermission(user, 'write', 'settings')).toBe(false);
      expect(checkPermission(user, 'read', 'notification')).toBe(true);
      expect(checkPermission(user, 'write', 'notification')).toBe(false);
    });

    test('should validate team-based access', () => {
      const checkTeamAccess = (user, targetResource) => {
        // Owner has access to all company data
        if (user.role === 'owner') return true;

        // Users can only access data from their team's company owner
        return user.companyOwner?.toString() === targetResource.owner?.toString();
      };

      const owner = { role: 'owner', _id: 'owner1' };
      const user = { role: 'member', companyOwner: 'owner1' };
      const resource = { owner: 'owner1' };
      const foreignResource = { owner: 'owner2' };

      expect(checkTeamAccess(owner, resource)).toBe(true);
      expect(checkTeamAccess(owner, foreignResource)).toBe(true);
      expect(checkTeamAccess(user, resource)).toBe(true);
      expect(checkTeamAccess(user, foreignResource)).toBe(false);
    });

    test('should validate hierarchical permissions', () => {
      const checkHierarchicalAccess = (user, targetUser) => {
        const roleHierarchy = { owner: 4, admin: 3, lead: 2, member: 1 };

        const userLevel = roleHierarchy[user.role] || 0;
        const targetLevel = roleHierarchy[targetUser.role] || 0;

        return userLevel > targetLevel;
      };

      const owner = { role: 'owner' };
      const admin = { role: 'admin' };
      const member = { role: 'member' };

      expect(checkHierarchicalAccess(owner, admin)).toBe(true);
      expect(checkHierarchicalAccess(admin, member)).toBe(true);
      expect(checkHierarchicalAccess(member, admin)).toBe(false);
      expect(checkHierarchicalAccess(member, member)).toBe(false);
    });
  });

  describe('Common Fields Validation', () => {
    test('should automatically set common fields', async () => {
      const owner = await TestDataFactory.createCompanyOwner();

      const client = await createTestClient(owner);

      expect(client.owner).toBeDefined();
      expect(client.created).toBeDefined();
      expect(client.removed).toBe(false);
    }, 30000);

    test('should update tracking fields on modification', async () => {
      const owner = await TestDataFactory.createCompanyOwner();
      const client = await createTestClient(owner);

      const originalUpdated = client.updated;

      // Update the client - in a real app, updatedBy would be set by middleware from user context
      client.name = 'Updated Name';
      // Don't set updatedBy to avoid auto-populate issues
      await client.save();

      expect(client.updated).not.toBe(originalUpdated);
      // Since we're not setting updatedBy to avoid auto-populate, we can't test it
    }, 30000);

    test('should handle soft deletion correctly', async () => {
      const owner = await TestDataFactory.createCompanyOwner();
      const client = await createTestClient(owner);

      // Soft delete - in a real app, removedBy would be set by business logic
      client.removed = true;
      client.removedAt = new Date();
      // Don't set removedBy to avoid auto-populate issues
      await client.save();

      expect(client.removed).toBe(true);
      expect(client.removedAt).toBeDefined();
      // Since we're not setting removedBy to avoid auto-populate, we can't test it

      // Verify it's excluded from normal queries
      const activeClients = await Client.find({ owner: owner._id, removed: false }).lean();
      expect(activeClients).toHaveLength(0);
    }, 30000);
  });

  describe('Reference Validation', () => {
    test('should validate cross-model references with owner', async () => {
      const owner1 = await TestDataFactory.createCompanyOwner();
      const owner2 = await TestDataFactory.createCompanyOwner();

      const client1 = await createTestClient(owner1);
      const client2 = await createTestClient(owner2);

      // Try to create invoice with client from different owner
      const invoiceData = {
        number: 1001,
        year: 2024,
        date: new Date(),
        expiredDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000),
        client: client2._id, // Client from owner2
        owner: owner1._id, // But invoice owned by owner1
        createdBy: owner1._id,
        items: [
          {
            itemName: 'Test',
            quantity: 1,
            price: 100,
            total: 100,
          },
        ],
        subTotal: 100,
        total: 100,
      };

      // This should be caught at business logic level
      const invoice = await new Invoice(invoiceData).save();
      expect(invoice).toBeDefined(); // Model allows it

      // But business logic should prevent cross-owner references
      const validateOwnership = (invoice, client) => {
        return invoice.owner.toString() === client.owner.toString();
      };

      expect(validateOwnership(invoice, client2)).toBe(false);
    });

    test('should validate payment-invoice owner consistency', async () => {
      const owner1 = await TestDataFactory.createCompanyOwner();
      const owner2 = await TestDataFactory.createCompanyOwner();

      const client1 = await TestDataFactory.createClient(owner1);
      const client2 = await TestDataFactory.createClient(owner2);

      const invoice1 = await TestDataFactory.createInvoice(owner1, client1);

      const paymentData = {
        number: 1001,
        client: client2._id, // Client from owner2
        invoice: invoice1._id, // Invoice from owner1
        amount: 100,
        currency: 'USD',
        date: new Date(),
        owner: owner1._id,
        createdBy: owner1._id,
      };

      const payment = await new Payment(paymentData).save();

      // Validate business rule
      const validatePaymentInvoiceOwnership = (payment, invoice) => {
        return payment.owner.toString() === invoice.owner.toString();
      };

      expect(validatePaymentInvoiceOwnership(payment, invoice1)).toBe(true);
    });
  });
});
