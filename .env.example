# =============================================================================
# ERP.js - Full-Stack Production & Self-Hosting Environment Template
# =============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#   docker compose up -d --build
#
# All social, advertising, and reputation modules operate on a 100% BYOC
# (Bring Your Own Credentials) model. If credentials are left blank, the platform
# runs in non-blocking Demo / Simulation Mode with realistic synthetic telemetry.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE INFRASTRUCTURE
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8888
DATABASE=mongodb://mongodb:27017/erp-crm
REDIS_URL=redis://redis:6379

# Security Secrets (Must be customized in production)
JWT_SECRET=replace_with_a_secure_random_64_char_string
MARKETING_ENCRYPTION_SECRET=replace_with_a_secure_random_32_char_encryption_key

# Public Application URLs
APP_URL=http://localhost
PUBLIC_SERVER_FILE=http://localhost:8888/

# -----------------------------------------------------------------------------
# EMAIL / SMTP (System notifications, password resets, review requests)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# -----------------------------------------------------------------------------
# META (Facebook & Instagram - Graph API v21.0, CAPI, Custom Audiences, Ads)
# -----------------------------------------------------------------------------
# How to get: Create an App at developers.facebook.com -> Add Marketing API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_PIXEL_ID=
META_WEBHOOK_VERIFY_TOKEN=erpjs_meta_webhook_verify_token

# -----------------------------------------------------------------------------
# GOOGLE (Google Ads API v16, Customer Match, Business Profile Reviews)
# -----------------------------------------------------------------------------
# How to get: Google Cloud Console -> Enable Google Ads API & Create OAuth Client
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# -----------------------------------------------------------------------------
# LINKEDIN (LinkedIn Marketing Solutions & Matched Audiences)
# -----------------------------------------------------------------------------
# How to get: LinkedIn Developer Portal -> Create App -> Request 'Community Management'
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_AD_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# TIKTOK (TikTok Business Marketing API & Events API)
# -----------------------------------------------------------------------------
# How to get: ads.tiktok.com/marketing_api/apps
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_PIXEL_CODE=

# -----------------------------------------------------------------------------
# X / TWITTER (X API v2 & Ads API v11)
# -----------------------------------------------------------------------------
# How to get: developer.x.com -> Developer Portal -> Project & App Keys
TWITTER_API_KEY=
TWITTER_API_KEY_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_ADS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# REPUTATION & REVIEWS (Trustpilot & Yelp Fusion)
# -----------------------------------------------------------------------------
# How to get: businessapp.trustpilot.com & yelp.com/developers
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
YELP_API_KEY=
YELP_BUSINESS_ID=

# -----------------------------------------------------------------------------
# OPTIONAL AI ASSISTANTS (Review auto-replies, smart lead summaries)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
