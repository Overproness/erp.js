export const logout = () => async (dispatch) => {
  dispatch({
    type: actionTypes.REQUEST_LOADING,
  });

  const data = await authService.logout();

  if (data) {
    // Use storePersist consistently
    storePersist.set('isLogout', true);
    storePersist.remove('auth');
    
    // Clean up any other stored state that might cause issues
    storePersist.remove('auth.current.remember');
    storePersist.remove('persist:root');
    
    dispatch({
      type: actionTypes.LOGOUT_SUCCESS,
    });
  } else {
    // Even if the server logout fails, we should still clear local state
    storePersist.set('isLogout', true);
    storePersist.remove('auth');
    
    dispatch({
      type: actionTypes.LOGOUT_SUCCESS,
    });
  }
};

export const updateUserAction =
  ({ entity, jsonData }) =>
  async (dispatch) => {
    try {
      dispatch({
        type: actionTypes.REQUEST_LOADING,
      });
      const data = await request.patch({ entity, id: jsonData._id, jsonData });

      if (data.success === true) {
        const auth_state = {
          current: {
            ...storePersist.get('auth').current,
            name: data.result.name,
          },
          isLoggedIn: true,
          isLoading: false,
          isSuccess: true,
        };
        // Use storePersist consistently
        storePersist.set('auth', auth_state);
        storePersist.remove('isLogout');
        dispatch({
          type: actionTypes.REQUEST_SUCCESS,
          payload: data.result,
        });
      } else {
        dispatch({
          type: actionTypes.REQUEST_FAILED,
        });
      }
    } catch (error) {
      console.log(error);
      dispatch({
        type: actionTypes.REQUEST_FAILED,
      });
    }
  };

export const sendEmail = async ({ entity, dataToSubmit }) => {
  try {
    return await request.post({ entity, jsonData: dataToSubmit });
  } catch (error) {
    return error;
  }
};
